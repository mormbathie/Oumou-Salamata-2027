[Unit]
Description=As Sakina encrypted Google Drive backup
After=network-online.target oumou-salamat-backup.service
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/oumou-salamat
ExecStart=/bin/bash /opt/oumou-salamat/deploy/offsite-backup.sh
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=30%
TimeoutStartSec=1800
