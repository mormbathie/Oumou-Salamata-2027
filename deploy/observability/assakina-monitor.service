[Unit]
Description=As Sakina monitoring email alerts
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/oumou-salamat
ExecStart=/usr/bin/python3 /opt/oumou-salamat/deploy/observability/monitor-alerts.py
UMask=0077
Nice=15
MemoryMax=96M
CPUQuota=15%
TimeoutStartSec=150
